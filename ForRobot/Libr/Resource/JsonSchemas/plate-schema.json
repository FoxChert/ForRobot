{
  "$schema": "http://json-schema.org/draft-04/schema",
  "title": "Plate Json-Schema",
  "description": "JSON-схема для валидации класса Plate",
  "x-class-name": "Plate",
  "x-full-name": "ForRobot.Models.Detals.Plate",
  "x-namespace": "ForRobot.Models.Detals",
  "type": "object",

  "properties": {
    "d_type": {
      "type": "string",
      "description": "Тип скоса"
    },

    "reverse_deflection": {
      "type": "number",
      "description": "Обратный прогиб детали"
    },

    "base_width": {
      "type": "number",
      "description": "Ширина настила"
    },

    "base_length": {
      "type": "number",
      "description": "Длина настила"
    },

    "base_thickness": {
      "type": "number",
      "description": "Толщина настила"
    },

    "base_bevel_left": {
      "type": "number",
      "description": "Скос настила слева"
    },

    "base_bevel_right": {
      "type": "number",
      "description": "Скос настила справа"
    },

    "base_displace": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Смещение настила от нулевой точки стола"
    },

    "welding_properties": {
      "type": "object",
      "properties": {
        "search_offset_start": {
          "type": "number",
          "description": "Отступ поиска в начале шва"
        },

        "search_offset_end": {
          "type": "number",
          "description": "Отступ поиска в конце шва"
        },

        "weld_tech_offset_start": {
          "type": "number",
          "description": "Технологический отступ начала шва"
        },

        "weld_tech_offset_end": {
          "type": "number",
          "description": "Технологический отступ конца шва"
        },

        "weld_overlap": {
          "type": "number",
          "description": "Перекрытие швов в месте соединения"
        },

        "weld_job": {
          "type": "integer",
          "description": "Номер используемого джоба (ячейки) на источнике"
        },

        "weld_velocity": {
          "type": "integer",
          "description": "Скорость сварки (обратно пропорциональна получаемому катету)"
        },

        "gantry_radius_weld": {
          "type": "number",
          "description": "Расстояние между фланцем робота и позиционера на сварке для расчёта положения позиционера"
        },

        "gantry_radius_search": {
          "type": "number",
          "description": "Расстояние между фланцем робота и позиционера на поисках"
        },

        "welds_list": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "weld_offset_left": {
                "type": "number",
                "description": "Отступ шва от левого края ребра"
              },

              "weld_offset_right": {
                "type": "number",
                "description": "Отступ шва от правого края ребра"
              }
            }
          },
          "minItems": 1,
          "description": "Коллекция швов",
          "required": [
            "weld_offset_left",
            "weld_offset_right"
          ]
        },

        "welding_schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "left_side": {
                "type": "string"
              },

              "right_side": {
                "type": "string"
              }
            }
          },
          //"minItems": 1,
          "description": "Схема сварки"
        }
      },
      "required": [
        "search_offset_start",
        "search_offset_end",
        "weld_tech_offset_start",
        "weld_tech_offset_end",
        "weld_overlap",
        "weld_job",
        "weld_velocity",
        "gantry_radius_weld",
        "gantry_radius_search",
        "welds_list"
        //"welding_schema"
      ],
      "description": "Коллекция параметров сварки"
    },

    "wall_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Кол-во рёбер"
    },

    "walls_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "wall_cross_dist_left": {
            "type": "number"
          },

          "wall_cross_dist_right": {
            "type": "number"
          },

          "wall_long_dist_left": {
            "type": "number"
          },

          "wall_long_dist_right": {
            "type": "number"
          },

          "wall_height": {
            "type": "number"
          },

          "wall_thickness": {
            "type": "number"
          }
        },
        "required": [
          "wall_height",
          "wall_thickness",
          "wall_cross_dist_left",
          "wall_cross_dist_right",
          "wall_long_dist_left",
          "wall_long_dist_right"
        ]
      },
      "minItems": 1,
      "description": "Коллекция рёбер"
    }
  },

  "required": [
    "d_type",
    "reverse_deflection",
    "base_width",
    "base_length",
    "base_thickness",
    "base_bevel_left",
    "base_bevel_right",
    "base_displace",
    "wall_count",
    "walls_list",
    "welding_properties"
  ]
}
