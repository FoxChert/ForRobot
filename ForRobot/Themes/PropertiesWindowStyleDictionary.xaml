<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ForRobot.Themes"
                    xmlns:properties="clr-namespace:ForRobot.Properties"
                    xmlns:h="http://helix-toolkit.org/wpf"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:ForRobot.Libr.Converters"
                    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                    xmlns:pt="clr-namespace:PropertyTools.Wpf;assembly=PropertyTools.Wpf"
                    xmlns:attached="clr-namespace:ForRobot.Libr.AttachedProperties">

    <Style x:Key="FrameworkElementBase" TargetType="{x:Type FrameworkElement}">
        <Setter Property="TextElement.FontSize" Value="{StaticResource FontSizeNP1}"/>
        <Setter Property="TextElement.FontFamily" Value="{StaticResource DefaultFont}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource ThemeFgP2Brush}"/>
        <Setter Property="TextElement.FontWeight" Value="Normal"/>
        <Setter Property="attached:SelectAttachedProperties.AttemptSelectedCommand" Value="{Binding Path=SelectClosedControlCommand}"/>
    </Style>

    <Style TargetType="{x:Type Label}" BasedOn="{StaticResource FrameworkElementBase}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource FrameworkElementBase}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="5"/>
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FrameworkElementBase}">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource FrameworkElementBase}">
        <Setter Property="Margin" Value="0,5"/>
        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource FrameworkElementBase}"></Style> 

    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource FrameworkElementBase}">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <!--<Setter Property="Padding" Value="5"/>-->
    </Style>

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource FrameworkElementBase}">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource FrameworkElementBase}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Padding="5"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <ResourceDictionary x:Key="SelectAppsWindowResource"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource FrameworkElementBase}">
            <Setter Property="Margin" Value="20, 5"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Padding" Value="5, 3"/>
        </Style>

        <Style TargetType="{x:Type ContentControl}" BasedOn="{StaticResource FrameworkElementBase}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}, Mode=FindAncestor}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" Margin="5"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ResourceDictionary>
    
    <Style x:Key="SelectAppsWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="Height" Value="500"/>
        <Setter Property="Width" Value="200"/>

        <Setter Property="FrameworkElement.Style">
            <Setter.Value>
                <Style TargetType="{x:Type FrameworkElement}">
                    <Setter Property="TextElement.FontSize" Value="{StaticResource FontSizeNP1}"/>
                    <Setter Property="TextElement.FontFamily" Value="DefaultFont"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource ThemeFgP2Brush}"/>
                </Style>
            </Setter.Value>
        </Setter>

        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Background="AliceBlue" Width="100"/>

                    <!--<Grid DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}, Mode=FindAncestor}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Tttt" Width="100"/>
                    </Grid>-->
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Вкладка "Общии"-->
    <DataTemplate x:Key="GeneralProperiesTemplate" DataType="{x:Type ContentControl}">
        <Grid Background="Transparent" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Обновление">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" Content="Автообновление" IsChecked="{Binding Path=Settings.AutoUpdate, Mode=TwoWay}"/>
                        <CheckBox Grid.Column="2" Content="Уведомлять пользователя перед обновлением" IsChecked="{Binding Path=Settings.InformUser, Mode=TwoWay}"
                                  IsEnabled="{Binding Path=Settings.AutoUpdate}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding Path=UpdatePath, Mode=OneWay, Source={x:Static properties:Settings.Default}}" IsEnabled="False"/>

                        <Button Grid.Column="2" Content="Изменить" Padding="10, 5" 
                                Command="{Binding Path=EditPathForUpdateCommand}"/>
                    </Grid>
                </Grid>
            </GroupBox>

            <CheckBox Grid.Row="1" Content="Вход в интерфейс по пин-коду" IsChecked="{Binding Path=Settings.LoginByPINCode, Mode=TwoWay}"
                      attached:SelectAttachedProperties.PreventSelect="True"/>

            <GroupBox Grid.Row="2" Header="Начальный файл для генерации">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Content="При запуске приложения создавать файл детали"
                              IsChecked="{Binding Path=Settings.CreatedDetalFile, Mode=TwoWay}"/>

                    <CheckBox Grid.Row="1" Content="Сохранять параметры детали перед закрытием"
                              IsChecked="{Binding Path=Settings.SaveDetalProperties, Mode=TwoWay}"
                              IsEnabled="{Binding Path=Settings.CreatedDetalFile}"/>

                    <ComboBox Grid.Row="2"
                              IsEnabled="{Binding Path=Settings.CreatedDetalFile}"
                              ItemsSource="{Binding Path=DetalTypesCollection, Mode=OneWay}"
                              SelectedItem="{Binding Path=Settings.StartedDetalType, Converter={StaticResource EnumDescriptionConverter}, Mode=TwoWay}"
                              SelectedIndex="0"/>
                </Grid>
            </GroupBox>

            <Button Grid.Row="3" Content="Изменить пин-код" Margin="15" Command="{Binding Path=EditPinCodeCommand}" 
                    VerticalAlignment="Bottom"/>
        </Grid>        
    </DataTemplate>

    <!--Вкладка "Навигация"-->
    <DataTemplate x:Key="NavigationTreeProperiesTemplate" DataType="{x:Type ContentControl}">
        <Grid Background="Transparent" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Видимость папок">
                <Grid>
                    <ListBox SelectionMode="Single" FontSize="13" Padding="0" Margin="3"
                             Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0"
                             ItemsSource="{Binding Path=Settings.AvailableFolders}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Path=Value, Mode=TwoWay}" Content="{Binding Path=Key}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <CheckBox Grid.Row="1" Margin="0, 5" Content="Доступны файлы с расширением .dat" IsChecked="{Binding Path=Settings.AccessDataFile, Mode=TwoWay}"/>
        </Grid>
    </DataTemplate>

    <!--Вкладка "Соединение"-->
    <DataTemplate x:Key="ConnectionProperiesTemplate" DataType="{x:Type ContentControl}">
        <Grid Background="Transparent" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Content="Ограничивать время ожидания ответа от сервера"
                      IsChecked="{Binding Path=Settings.LimitedConnectionTimeOut, Mode=TwoWay}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Время ожидания, сек."/>
                <Slider Grid.Column="1" Value="{Binding Path=Settings.ConnectionTimeOut, Mode=TwoWay}" Minimum="3" Maximum="20" TickPlacement="BottomRight" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ColumnDefinition}, Mode=FindAncestor}}"/>
                <TextBlock Grid.Column="2" Text="{Binding Path=Settings.ConnectionTimeOut, Mode=OneWay, StringFormat='{}{0:0.0}'}"/>
            </Grid>
        </Grid>
    </DataTemplate>

    <!--Вкладка "Интерфейс"-->
    <DataTemplate x:Key="InterfaceProperiesTemplate" DataType="{x:Type ContentControl}">
        <Grid DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Цветовая тема"/>
                
                <ComboBox Grid.Column="1" Margin="4"
                          DisplayMemberPath="Item1"
                          ItemsSource="{Binding Path=Settings.Themes, Mode=OneWay}"
                          SelectedItem="{Binding Path=Settings.SelectedTheme, Mode=TwoWay}"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=Item1}" Padding="5"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <GroupBox Grid.Row="1" Header="Панели интерфейса">
                <Grid>
                    <ListBox SelectionMode="Single"
                             Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0"
                             ItemsSource="{Binding Path=AnchorablesCollection, Mode=OneWay}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton IsChecked="{Binding Path=IsVisible}" Height="25" Width="25">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Path Fill="Black" Stretch="Uniform" StrokeThickness="1">
                                                    <Path.Style>
                                                        <Style TargetType="{x:Type Path}">
                                                            <Setter Property="Data" Value="{DynamicResource EyePathGeomerty}"/>

                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Path=IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}, Mode=FindAncestor}}" Value="False">
                                                                    <Setter Property="Data" Value="{DynamicResource EyeOffPathGeomerty}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    
                                    <Label Content="{Binding Path=Title}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <Button Grid.Row="2" Content="Удалить изменения интерфейса" Margin="10" Command="{Binding Path=DeleteAvalonConfigFileCommand}"/>
        </Grid>
    </DataTemplate>

    <!--Вкладка "3D сцена"-->
    <DataTemplate x:Key="3DViewProperiesTemplate" DataType="{x:Type ContentControl}">
        <Grid Background="Transparent" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Маштаб 3д модели 1:"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Path=Settings.ScaleFactor, StringFormat={}{0:D}, Converter={StaticResource ScaleFactorConvert}, Mode=TwoWay}"
                         HorizontalContentAlignment="Left"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0, 5">
                    <TextBlock Text="Толщина шва"/>
                    <Slider Value="{Binding Path=Settings.WeldsThickness, Mode=TwoWay}" Minimum="1" Maximum="8" TickPlacement="BottomRight" TickFrequency="0.5" IsSnapToTickEnabled="True" Width="300"/>
                    <TextBlock Text="{Binding Path=Settings.WeldsThickness, Mode=OneWay, StringFormat='{}{0:0.0}'}"/>
                </StackPanel>
            </Grid>

            <GroupBox Grid.Row="1" Header="Отображение параметров">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Content="Видимость" IsChecked="{Binding Path=Settings.ParamsIsVisibale, Mode=TwoWay}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="Размер шрифта"/>
                        <Slider Value="{Binding Path=Settings.ParamsFontSize, Mode=TwoWay}" Minimum="6" Maximum="52" TickPlacement="BottomRight" TickFrequency="2" IsSnapToTickEnabled="True" Width="300"/>
                        <TextBlock Text="{Binding Path=Settings.ParamsFontSize, Mode=OneWay, StringFormat='{}{0:0}'}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Система координат">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="Видимость" IsChecked="{Binding Path=Settings.ShowCoordinateSystem, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Вертикальное расположение"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Горизонтальное расположение"/>

                    <ComboBox Grid.Row="1" Grid.Column="1" 
                              ItemsSource="{Binding Path=VerticalAlignments, Mode=OneWay}"
                              SelectedItem="{Binding Path=Settings.CoordinateSystemVerticalPosition, Mode=TwoWay}"/>

                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding Path=HorizontalAlignments, Mode=OneWay}"
                              SelectedItem="{Binding Path=Settings.CoordinateSystemHorizontalPosition, Mode=TwoWay}"/>
                </Grid>
            </GroupBox>

            <CheckBox Grid.Row="3" Content="Пространственный куб" IsChecked="{Binding Path=Settings.ShowViewCube, Mode=TwoWay}"/>
            <CheckBox Grid.Row="4" Content="Доступности нажатия рёбер пространственного куба" IsChecked="{Binding Path=Settings.IsViewCubeEdgeClicksEnabled, Mode=TwoWay}"/>
            <CheckBox Grid.Row="5" Content="Количество полигонов" IsChecked="{Binding Path=Settings.ShowTriangleCountInfo, Mode=TwoWay}"/>
            <CheckBox Grid.Row="6" Content="Количество кадров" IsChecked="{Binding Path=Settings.ShowFrameRate, Mode=TwoWay}"/>

            <GroupBox Grid.Row="7" Header="Камера">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Content="Включена ли ортоганальная камера" IsChecked="{Binding Path=Settings.Orthographic, Mode=TwoWay}"/>
                    <CheckBox Grid.Row="1" Content="Демонстрация информации о камере" IsChecked="{Binding Path=Settings.ShowCameraInfo, Mode=TwoWay}"/>
                    <CheckBox Grid.Row="2" Content="Демонстрация курсора камеры" IsChecked="{Binding Path=Settings.ShowCameraTarget, Mode=TwoWay}"/>
                    <CheckBox Grid.Row="3" Content="Поворот камеры осуществляется вокруг курсора мыши" IsChecked="{Binding Path=Settings.RotateAroundMouseDownPoint, Mode=TwoWay}"/>
                    <CheckBox Grid.Row="4" Content="Приближение камеры осуществляется в месте курсора мыши" IsChecked="{Binding Path=Settings.ZoomAroundMouseDownPoint, Mode=TwoWay}"/>
                    <CheckBox Grid.Row="5" Content="Инерция камеры" IsChecked="{Binding Path=Settings.IsInertiaEnabled, Mode=TwoWay}"/>
                    <CheckBox Grid.Row="6" Content="Включено ли панорамирование" IsChecked="{Binding Path=Settings.IsPanEnabled, Mode=TwoWay}"/>
                    <CheckBox Grid.Row="7" Content="Включено ли перемещение" IsChecked="{Binding Path=Settings.IsMoveEnabled, Mode=TwoWay}"/>
                    <CheckBox Grid.Row="8" Content="Включено ли вращение" IsChecked="{Binding Path=Settings.IsRotationEnabled, Mode=TwoWay}"/>
                    <CheckBox Grid.Row="9" Content="Включено ли маштабирование" IsChecked="{Binding Path=Settings.IsZoomEnabled, Mode=TwoWay}"/>

                    <StackPanel Grid.Row="10" Orientation="Horizontal">
                        <Label Content="Чувствительность вращения"/>
                        <Slider Value="{Binding Path=Settings.RotationSensitivity, Mode=TwoWay}" Minimum="0.1" Maximum="5" Width="200"/>
                        <TextBlock Text="{Binding Path=Settings.RotationSensitivity, Mode=OneWay, StringFormat='{}{0:0.0}'}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="11" Orientation="Horizontal">
                        <Label Content="Чувствительность маштабирования"/>
                        <Slider Value="{Binding Path=Settings.ZoomSensitivity, Mode=TwoWay}" Minimum="0.1" Maximum="5" Width="200"/>
                        <TextBlock Text="{Binding Path=Settings.ZoomSensitivity, Mode=OneWay, StringFormat='{}{0:0.0}'}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="12" Orientation="Horizontal">
                        <Label Content="Степень инерции камеры"/>
                        <Slider Value="{Binding Path=Settings.CameraInertiaFactor, Mode=TwoWay}" Minimum="0.7" Maximum="1" Width="200"/>
                        <TextBlock Text="{Binding Path=Settings.CameraInertiaFactor, Mode=OneWay, StringFormat='{}{0:0.0}'}"/>
                    </StackPanel>
                    
                    <GroupBox Grid.Row="13" Header="Режим поворота камеры">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0" GroupName="CameraRotation" Content="Turntable" IsChecked="{Binding Path=Settings.CameraRotationMode,
                                                                                                                         Converter={StaticResource ResourceKey=RadioButtonConvert}, 
                                                                                                                         ConverterParameter=Turntable, Mode=TwoWay,
                                                                                                                         TargetNullValue={StaticResource False}, FallbackValue={StaticResource False}}"/>

                            <RadioButton Grid.Column="1" GroupName="CameraRotation" Content="Turnball" IsChecked="{Binding Path=Settings.CameraRotationMode,
                                                                                                                         Converter={StaticResource ResourceKey=RadioButtonConvert}, 
                                                                                                                         ConverterParameter=Turnball, Mode=TwoWay,
                                                                                                                         TargetNullValue={StaticResource False}, FallbackValue={StaticResource False}}"/>

                            <RadioButton Grid.Column="2" GroupName="CameraRotation" Content="Trackball" IsChecked="{Binding Path=Settings.CameraRotationMode,
                                                                                                                         Converter={StaticResource ResourceKey=RadioButtonConvert}, 
                                                                                                                         ConverterParameter=Trackball, Mode=TwoWay,
                                                                                                                         TargetNullValue={StaticResource False}, FallbackValue={StaticResource False}}"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="14" Header="Режим работы камеры">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0" GroupName="CameraMode" Content="Inspect" IsChecked="{Binding Path=Settings.CameraMode,
                                                                                                                         Converter={StaticResource ResourceKey=RadioButtonConvert}, 
                                                                                                                         ConverterParameter=Inspect, Mode=TwoWay,
                                                                                                                         TargetNullValue={StaticResource False}, FallbackValue={StaticResource False}}"/>

                            <RadioButton Grid.Column="1" GroupName="CameraMode" Content="CameraMode" IsChecked="{Binding Path=Settings.CameraMode,
                                                                                                                         Converter={StaticResource ResourceKey=RadioButtonConvert}, 
                                                                                                                         ConverterParameter=WalkAround, Mode=TwoWay,
                                                                                                                         TargetNullValue={StaticResource False}, FallbackValue={StaticResource False}}"/>

                            <RadioButton Grid.Column="2" GroupName="CameraMode" Content="WalkAround" IsChecked="{Binding Path=Settings.CameraMode,
                                                                                                                         Converter={StaticResource ResourceKey=RadioButtonConvert}, 
                                                                                                                         ConverterParameter=FixedPosition, Mode=TwoWay,
                                                                                                                         TargetNullValue={StaticResource False}, FallbackValue={StaticResource False}}"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="8" Header="Цветовое обозначение">
                <Grid TextElement.FontWeight="Normal">
                    <ListBox SelectionMode="Single"
                             Background="{x:Null}" BorderBrush="{x:Null}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ItemsSource="{Binding Path=Settings.Colors, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DictionaryToBindableCollectionConvert}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0">
                                        <TextBlock x:Name="PropertyNameTextBlock" Text="{Binding Path=PropertyName}" VerticalAlignment="Center"/>
                                    </Border>

                                    <pt:ColorPicker Grid.Column="2" HorizontalContentAlignment="Right" Padding="5" Margin="5"
                                                    SelectedColor="{Binding Path=Color, Mode=TwoWay,
                                                                            Converter={StaticResource ColorSaveConvert}, 
                                                                            ConverterParameter={x:Reference PropertyNameTextBlock}}"
                                                    Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}, Mode=FindAncestor}}"
                                                    Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type StackPanel}, Mode=FindAncestor}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>
        </Grid>
    </DataTemplate>

    <!--Вкладка "Генерация"-->
    <DataTemplate x:Key="GenerationProperiesTemplate" DataType="{x:Type ContentControl}">
        <Grid Background="Transparent" DataContext="{Binding Path=DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Content="Запрашивать имя файла при каждой генерации" IsChecked="{Binding Path=Settings.AskNameFile, Mode=TwoWay}"/>

            <GroupBox Grid.Row="1" Header="Стандартное наименование итогового файла от типа детали:"
                      IsEnabled="{Binding Path=Settings.AskNameFile, Converter={StaticResource InvertBooleanConverter}}">
                <Grid TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Path=Settings.DetalsProgramNames, Source={x:Static Application.Current}, Mode=OneWay}"
                              SelectedItem="{Binding Path=SelectedTumpleProgramName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=Key, Converter={StaticResource EnumDescriptionConverter}}" Padding="5"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox x:Name="NameFile" Grid.Column="1" Text="{Binding Path=SelectedTumpleProgramName.Value, Mode=TwoWay}"
                             attached:SelectAttachedProperties.PreventSelect="True"/>
                </Grid>
            </GroupBox>
            
            <GroupBox Grid.Row="2" Header="Стандартный скрипт-генератор деталей:">
                <Grid TextElement.FontWeight="Normal">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Path=Settings.DetalsScriptNames, Source={x:Static Application.Current}, Mode=OneWay}"
                              SelectedItem="{Binding Path=SelectedTumpleScriptsName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=Key, Converter={StaticResource EnumDescriptionConverter}}" Padding="5"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox x:Name="NameScript" Grid.Column="1" Text="{Binding Path=SelectedTumpleScriptsName.Value, Mode=TwoWay}"
                             attached:SelectAttachedProperties.PreventSelect="True"/>
                </Grid>
            </GroupBox>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Content="Выбор скрипта перед запуском" IsChecked="{Binding Path=Settings.AskScriptFile, Source={x:Static Application.Current}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="1" Content="Изменить"
                        ToolTip="Изменение перечня скриптов"
                        Command="{Binding OpenScriptsSelectorCommand}"/>
            </Grid>

            <CheckBox Grid.Row="4" Content="Копирование сгенерированной программы на контроллер" IsChecked="{Binding Path=Settings.SendingGeneratedFiles, Source={x:Static Application.Current}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
    </DataTemplate>
</ResourceDictionary>