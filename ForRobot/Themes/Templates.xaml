                                <Setter Property="Width" Value="30"/>
                            </Style>

                            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource PathBase}"></Style>

                            <ControlTemplate x:Key="SeparatorTemplate" TargetType="{x:Type MenuItem}">
