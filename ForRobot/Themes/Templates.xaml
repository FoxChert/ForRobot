                                                                  Style="{StaticResource TextBase}"/>
                                    </StackPanel>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Panel" Property="Background" Value="{StaticResource Menu.IsMouseOver.Background}"/>
