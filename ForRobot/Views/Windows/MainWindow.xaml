                                <!--
                                </hx:Viewport3DX>-->
                            </Grid>
                        </DataTemplate>
                    </control:PanesTemplateSelector.FileViewTemplate>
                </control:PanesTemplateSelector>
            </DockingManager.LayoutItemTemplateSelector>

            <DockingManager.Resources>
                <Style TargetType="{x:Type ContentControl}" BasedOn="{StaticResource ContentControlBase}">
                    <Setter Property="Padding" Value="10"/>
                </Style>
            </DockingManager.Resources>

            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">
                    <avalonDock:LayoutPanel Orientation="Vertical">
                        <avalonDock:LayoutDocumentPaneGroup>
                            <avalonDock:LayoutDocumentPane></avalonDock:LayoutDocumentPane>
                        </avalonDock:LayoutDocumentPaneGroup>

                        <avalonDock:LayoutAnchorablePaneGroup>
                            <avalonDock:LayoutAnchorablePane>
                                <avalonDock:LayoutAnchorable Title="Сообщения" ContentId="Messages">
                                    <avalonDock:LayoutAnchorable.IconSource>
                                        <DrawingImage>
                                            <DrawingImage.Drawing>
                                                <GeometryDrawing Brush="Black" Geometry="{DynamicResource JournalGeometryPath}"/>
                                            </DrawingImage.Drawing>
                                        </DrawingImage>
                                    </avalonDock:LayoutAnchorable.IconSource>

                                    <ContentControl ContentTemplate="{StaticResource MessagesLayoutAnchorableTemplate}"/>
                                </avalonDock:LayoutAnchorable>
                            </avalonDock:LayoutAnchorablePane>
                        </avalonDock:LayoutAnchorablePaneGroup>
                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutPanel>

                <avalonDock:LayoutRoot.LeftSide>
                    <avalonDock:LayoutAnchorSide>
                        <avalonDock:LayoutAnchorGroup>
                            <avalonDock:LayoutAnchorable Title="Параметры детали" ContentId="ParametrsOfDetal">
                                <Grid>
                                    <Grid.Resources>
                                        <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource FrameworkElementBase}">
                                            <Setter Property="Background" Value="{StaticResource ToolTip.Background}"/>
                                            <Setter Property="Padding" Value="15.5"/>
                                            <Setter Property="Opacity" Value="0.90"/>
                                            <!--<Setter Property="IsOpen" Value="{Binding Path=Parent.IsKeyboardFocused, Mode=OneWay}"/>-->

                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ToolTip}">
                                                        <Popup PlacementTarget="{TemplateBinding Property=PlacementTarget}"
                                                               IsOpen="{Binding Path=IsOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                               AllowsTransparency="True" AllowDrop="True"
                                                               Placement="Right">

                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"
                                                                    Opacity="{TemplateBinding Opacity}" Padding="{TemplateBinding Padding}">

                                                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                                                            </Border>
                                                        </Popup>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <Style TargetType="{x:Type TreeViewItem}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>

                                        <Style x:Key="TextBlockBase" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextBlockBase}">
                                            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ColumnDefinition}, Mode=FindAncestor}}"/>
                                            <Setter Property="MaxWidth"  Value="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ColumnDefinition}, Mode=FindAncestor}}"/>
                                            <Setter Property="TextAlignment" Value="Left"/>
                                        </Style>

                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextBlockBase}"/>
                                        
                                        <!--<Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TextBlockBase}">
                                            -->
                                        <!--<Setter Property="Width"  Value="{Binding Path=Width, RelativeSource={RelativeSource AncestorType={x:Type ColumnDefinition}, Mode=FindAncestor}}"/>--><!--
                                            <Setter Property="MaxWidth"  Value="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ColumnDefinition}, Mode=FindAncestor}}"/>
                                            <Setter Property="TextAlignment" Value="Left"/>
                                        </Style>-->
                                    </Grid.Resources>

                                    <control:ParamsTreeView>
                                        <TreeViewItem Header="Общие">
                                            <ContentControl ContentTemplate="{StaticResource PlateParametrsTemplate}"/>
                                        </TreeViewItem>

                                        <TreeViewItem Header="Доп.">
                                            <ContentControl ContentTemplate="{StaticResource PlateAddParametrsTemplate}"/>
                                        </TreeViewItem>

                                        <TreeViewItem Header="Сварка">
                                            <ContentControl ContentTemplate="{StaticResource PlateWeldingParametrsTemplate}"/>
                                        </TreeViewItem>
                                        
                                        <!--<control:ParamsTreeView.Style>
                                            <Style TargetType="{x:Type control:ParamsTreeView}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=SelectedFile.CurrentDetal, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </control:ParamsTreeView.Style>-->
                                    </control:ParamsTreeView>
                                </Grid>
                            </avalonDock:LayoutAnchorable>

                            <avalonDock:LayoutAnchorable Title="Свойства" ContentId="Properties">
                                <!--<pt:PropertyGrid SelectedObject="{Binding Path=DataContext.SelectedObject, 
                                                                              RelativeSource={RelativeSource AncestorType={x:Type Window}, Mode=FindAncestor},
                                                                              UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                                     TabVisibility="Collapsed"
                                                    
                                                     Margin="4"/>-->
                                <ContentControl ContentTemplate="{StaticResource OtherTemplate}"/>
                            </avalonDock:LayoutAnchorable>

                            <avalonDock:LayoutAnchorable Title="Состав" ContentId="Components">
                                <control:SceneItemsTreeView FontSize="{StaticResource FontSizeNP2}"
                                                            ItemsSource="{Binding Path=SceneItemsCollection, Mode=OneWay}"/>

                                <!--<ContentControl ContentTemplate="{StaticResource OtherTemplate}"/>-->
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorGroup>
                    </avalonDock:LayoutAnchorSide>
                </avalonDock:LayoutRoot.LeftSide>

                <avalonDock:LayoutRoot.RightSide>
                    <avalonDock:LayoutAnchorSide>
                        <avalonDock:LayoutAnchorGroup>
                            <avalonDock:LayoutAnchorable Title="Соединения" ContentId="Connections" AutoHideMinWidth="400" IsVisible="False"
                                                         attached:SelectAttachedProperties.PreventSelect="True">

                                <ContentControl ContentTemplate="{StaticResource ConnectionsLayoutAnchorableTemplate}"/>
                            </avalonDock:LayoutAnchorable>

                            <avalonDock:LayoutAnchorable Title="Управление" ContentId="Control" AutoHideMinWidth="900">
                                <ContentControl ContentTemplate="{StaticResource ControlLayoutAnchorableTemplate}"/>
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorGroup>
                    </avalonDock:LayoutAnchorSide>
                </avalonDock:LayoutRoot.RightSide>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <DockPanel Grid.Row="3" Background="{StaticResource BottomMenu.DockPanel.Background}">

        </DockPanel>
    </Grid>
</Window>
