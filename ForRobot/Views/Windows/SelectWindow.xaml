<Window x:Class="ForRobot.Views.Windows.SelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ForRobot.Views.Windows"
        mc:Ignorable="d"
        Title="Окно выбора"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Background="Gainsboro"
        ResizeMode="NoResize"
        Icon="/InterfaceOfRobots;component/Themes/Icons/checkbox.ico"
        Template="{DynamicResource WindowTemplate}">

    <Window.Resources>
        <Style TargetType="{x:Type FrameworkElement}">
            <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeNP1}"/>
            <Setter Property="TextElement.FontFamily" Value="DefaultFont"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeFgP2Brush}"/>
        </Style>
        
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="20, 5"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15, 3"/>
        </Style>

        <ControlTemplate x:Key="WindowTemplate" TargetType="{x:Type Window}">
            <Border BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                <Grid Margin="20, 10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="SelectedComboBox" Text="Xoo" IsEditable="True"
                              ItemsSource="{Binding Path=ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                              SelectedItem="{Binding Path=SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                              HorizontalContentAlignment="Center"
                              Padding="0, 5" Margin="0, 0, 0, 5">
                        
                    </ComboBox>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="_Отмена" IsCancel="True"/>
                        <Button Grid.Column="1" Content="_OK" IsDefault="True"/>
                    </Grid>
                </Grid>
            </Border>
        </ControlTemplate>
    </Window.Resources>

